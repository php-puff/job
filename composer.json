{
    "name": "puff/job",
    "description": "Fiber-based cron job scheduler for PHP Unison Fiber Framework",
    "type": "library",
    "keywords": [
        "php",
        "cron",
        "scheduler",
        "fiber",
        "puff"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "puff/application": "dev-main",
        "puff/async": "dev-main",
        "psr/log": "^3.0"
    },
    "require-dev": {
        "puff/config": "dev-main",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "Puff\\Job\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Puff\\Job\\Tests\\": "tests/"
        }
    },
    "extra": {
        "puff": {
            "config": {"job.php": "config/job.php"},
            "apps": [
                "Puff\\Job\\ServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "preferred-install": "dist",
        "sort-packages": true
    },
    "scripts": {
        "test": "phpunit tests",
        "analyse": "phpstan analyse src tests --level=8 --memory-limit=1G"
    }
}
